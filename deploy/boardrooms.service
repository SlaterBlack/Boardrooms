[Unit]
Description=Boardrooms AI meeting hub
After=network.target

[Service]
Type=simple
User=ai3d
Group=www-data
WorkingDirectory=/var/www/Boardrooms
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=0.0.0.0
EnvironmentFile=-/var/www/Boardrooms/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/Boardrooms/.boardrooms-data

[Install]
WantedBy=multi-user.target
